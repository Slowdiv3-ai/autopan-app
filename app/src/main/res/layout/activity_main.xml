<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">
        
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto Pan Control"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp"/>
        
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: OFF"
            android:textSize="20sp"
            android:textColor="#FF4444"
            android:layout_marginBottom="20dp"/>
        
        <Button
            android:id="@+id/toggleButton"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:text="START PAN"
            android:textSize="24sp"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="30dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Pattern:"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>
        
        <RadioGroup
            android:id="@+id/patternGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">
            
            <RadioButton
                android:id="@+id/radioSmooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smooth (default)"
                android:textColor="#FFFFFF"
                android:buttonTint="#4CAF50"/>
            
            <RadioButton
                android:id="@+id/radioHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hard Left/Right"
                android:textColor="#FFFFFF"
                android:buttonTint="#FF9800"/>
            
            <RadioButton
                android:id="@+id/radioWave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wave"
                android:textColor="#FFFFFF"
                android:buttonTint="#2196F3"/>
            
            <RadioButton
                android:id="@+id/radioSubtle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtle (gentle)"
                android:textColor="#FFFFFF"
                android:buttonTint="#9C27B0"/>
            
            <RadioButton
                android:id="@+id/radioCrazy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crazy (random jumps)"
                android:textColor="#FFFFFF"
                android:buttonTint="#F44336"/>
            
        </RadioGroup>
        
    </LinearLayout>
</ScrollView>
