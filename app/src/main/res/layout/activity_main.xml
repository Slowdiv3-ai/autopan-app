<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto Pan Control"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp"/>
        
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: OFF"
            android:textSize="20sp"
            android:textColor="#FF4444"
            android:layout_marginBottom="20dp"/>
        
        <Button
            android:id="@+id/toggleButton"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:text="START PAN"
            android:textSize="24sp"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="20dp"/>
        
        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Accessibility Toggle"
            android:textSize="14sp"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="20dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bluetooth Auto-Pan:"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="5dp"/>
        
        <Switch
            android:id="@+id/bluetoothSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smooth All Patterns:"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="5dp"/>
        
        <Switch
            android:id="@+id/smoothSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panning Speed:"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>
        
        <TextView
            android:id="@+id/speedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed: 1000ms"
            android:textSize="14sp"
            android:textColor="#BBBBBB"
            android:layout_marginBottom="5dp"/>
        
        <SeekBar
            android:id="@+id/speedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="10"
            android:layout_marginBottom="30dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Pattern:"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>
        
        <RadioGroup
            android:id="@+id/patternGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">
            
            <RadioButton
                android:id="@+id/radioSmooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smooth"
                android:textColor="#FFFFFF"
                android:buttonTint="#4CAF50"/>
            
            <RadioButton
                android:id="@+id/radioHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hard Left/Right"
                android:textColor="#FFFFFF"
                android:buttonTint="#FF9800"/>
            
            <RadioButton
                android:id="@+id/radioWave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wave"
                android:textColor="#FFFFFF"
                android:buttonTint="#2196F3"/>
            
            <RadioButton
                android:id="@+id/radioSubtle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtle"
                android:textColor="#FFFFFF"
                android:buttonTint="#9C27B0"/>
            
            <RadioButton
                android:id="@+id/radioCrazy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crazy"
                android:textColor="#FFFFFF"
                android:buttonTint="#F44336"/>
            
            <RadioButton
                android:id="@+id/radioCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Pattern"
                android:textColor="#FFFFFF"
                android:buttonTint="#00BCD4"/>
            
        </RadioGroup>
        
        <LinearLayout
            android:id="@+id/customContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="10dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Pattern:"
                android:textSize="16sp"
                android:textColor="#00BCD4"
                android:layout_marginBottom="15dp"/>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="10dp"
                android:layout_marginBottom="20dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LEFT"
                        android:textSize="12sp"
                        android:textColor="#FF5722"
                        android:gravity="start"/>
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CENTER"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="RIGHT"
                        android:textSize="12sp"
                        android:textColor="#4CAF50"
                        android:gravity="end"/>
                    
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/graphArea"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="vertical"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-0.8"
                        android:textSize="10sp"
                        android:textColor="#888888"
                        android:gravity="start"/>
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-0.4"
                        android:textSize="10sp"
                        android:textColor="#888888"
                        android:gravity="center"/>
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+0.4"
                        android:textSize="10sp"
                        android:textColor="#888888"
                        android:gravity="center"/>
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+0.8"
                        android:textSize="10sp"
                        android:textColor="#888888"
                        android:gravity="end"/>
                    
                </LinearLayout>
                
            </LinearLayout>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Presets:"
                android:textSize="14sp"
                android:textColor="#BBBBBB"
                android:layout_marginBottom="10dp"/>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">
                
                <Button
                    android:id="@+id/presetSmooth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Smooth"
                    android:textSize="12sp"
                    android:backgroundTint="#4CAF50"
                    android:layout_margin="2dp"/>
                
                <Button
                    android:id="@+id/presetBounce"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bounce"
                    android:textSize="12sp"
                    android:backgroundTint="#FF9800"
                    android:layout_margin="2dp"/>
                
                <Button
                    android:id="@+id/presetCircle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Circle"
                    android:textSize="12sp"
                    android:backgroundTint="#2196F3"
                    android:layout_margin="2dp"/>
                
            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/slidersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
            
        </LinearLayout>
        
    </LinearLayout>
</ScrollView>
